# Copy to apps/api/.env and adjust. Placeholders only - never commit real values.
# Every variable is validated at startup by src/config/env.ts.

NODE_ENV=development
PORT=4000

# Mounted prefix for all routes. Must start with "/".
API_PREFIX=/api/v1

# MongoDB connection string.
# Leave empty in development to run the API without a database: the health
# endpoint then reports the database as "not_configured" instead of pretending
# it is healthy. It is REQUIRED when NODE_ENV=production.
MONGODB_URI=

# Comma-separated list of browser origins allowed by CORS.
# Wildcards are rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Sprint 3: persistence and caching.
# Upper bound (seconds) for a cached comparison response. The effective TTL is
# always the smallest remaining source freshness, never longer. 0 disables caching.
COMPARISON_CACHE_TTL_SECONDS=300

# Store sample (demo) price observations in MongoDB. Defaults to true outside
# production and false in production, because invented prices must not accumulate
# as if they were marketplace history.
PERSIST_DEMO_SNAPSHOTS=true

# Sprint 4: historical retention / compaction.
# These are product decisions, not legal requirements. Raw observations younger
# than RETENTION_RAW_DAYS stay at full resolution; older days are compacted into
# daily rollups and deleted only after that rollup is verified.
RETENTION_RAW_DAYS=30
# Daily rollups are kept this long, then pruned. Must be >= RETENTION_RAW_DAYS.
RETENTION_ROLLUP_DAYS=730
# Documents per read/delete batch.
RETENTION_BATCH_SIZE=500
# The manual job (`npm run retention`) reports only unless you pass --apply.
RETENTION_DRY_RUN=true
