{
  "name": "@smart-shopping/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Smart Shopping Platform mobile client (Expo + React Native + TypeScript)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests=false",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@smart-shopping/shared": "*",
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.69.0",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3"
  }
}
