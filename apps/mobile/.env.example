# Copy to apps/mobile/.env
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are therefore PUBLIC.
# Never put secrets here: the mobile app talks only to the platform API.
#
# Host mapping for local development:
#   Android emulator -> http://10.0.2.2:4000/api/v1
#   iOS simulator    -> http://localhost:4000/api/v1
#   Physical device  -> http://<your-computer-LAN-IP>:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
