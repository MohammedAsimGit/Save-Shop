# =============================================================================
# Smart Shopping Platform - example environment variables (PLACEHOLDERS ONLY)
# =============================================================================
# Copy the relevant values into the right place; never commit real secrets.
#   Backend  -> apps/api/.env        (copy apps/api/.env.example)
#   Web      -> apps/web/.env.local  (copy apps/web/.env.example)
#   Mobile   -> apps/mobile/.env     (copy apps/mobile/.env.example)
#
# Every variable below is a placeholder. No real credentials exist yet.
# Which Firebase / marketplace variables are actually required is an OPEN
# QUESTION (see docs/MARKETPLACE_INTEGRATIONS.md) - do not assume they work.
# =============================================================================

# --- Backend (apps/api) ------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# MongoDB connection string. Leave unset in development to run the API without a
# database (health check then reports the database as "not_configured").
MONGODB_URI=
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Web frontend (apps/web) -------------------------------------------------
# Only non-secret values may use the VITE_ prefix: anything VITE_* is embedded
# in the public browser bundle.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Mobile (apps/mobile) ----------------------------------------------------
# EXPO_PUBLIC_* is embedded in the app bundle. Use 10.0.2.2 instead of
# localhost when calling the API from the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# --- Future integrations (NOT configured, NOT verified) ----------------------
# Firebase Authentication is planned for a later sprint.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=placeholder@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nplaceholder\n-----END PRIVATE KEY-----\n"

# Marketplace API access has NOT been granted or investigated yet.
# Placeholders exist only to document where such secrets would live.
MARKETPLACE_API_KEY=placeholder-marketplace-api-key
MARKETPLACE_API_SECRET=placeholder-marketplace-api-secret
